# MongoDB Assistant - FastAPI Application
FROM python:3.10-slim as builder

# Install system dependencies for building Python packages
RUN apt-get update && apt-get install -y \
    build-essential \
    cmake \
    pkg-config \
    && rm -rf /var/lib/apt/lists/*

# Create and use a non-root user for building
RUN useradd --create-home --shell /bin/bash app
USER app
WORKDIR /home/app

# Copy requirements and install Python dependencies
COPY requirements.txt .
RUN pip install --user --no-cache-dir --no-warn-script-location -r requirements.txt

# Production stage
FROM python:3.10-slim as production

# Install runtime dependencies
RUN apt-get update && apt-get install -y \
    curl \
    && rm -rf /var/lib/apt/lists/*

# Create app user and directories
RUN useradd --create-home --shell /bin/bash app
USER app
WORKDIR /home/app

# Copy Python packages from builder stage
COPY --from=builder --chown=app:app /home/app/.local /home/app/.local

# Make sure scripts in .local are usable
ENV PATH=/home/app/.local/bin:$PATH

# Copy application code
COPY --chown=app:app src/ ./src/
COPY --chown=app:app cfg/ ./cfg/
COPY --chown=app:app pyproject.toml ./

# Create directories for models and ensure proper permissions
RUN mkdir -p models && chmod 755 models

# Set environment variables
ENV PYTHONPATH=/home/app
ENV PYTHONDONTWRITEBYTECODE=1
ENV PYTHONUNBUFFERED=1

# Default environment variables (can be overridden)
# ENV WORKFLOW_PROVIDER=JSON
# ENV WORKFLOW_DIR=cfg/workflows
# ENV LLM_PROVIDER=LOCAL
# ENV LLM_LOCAL_MODEL_N_CTX=4096
# ENV LLM_LOCAL_MODEL_N_THREADS=4
# ENV LLM_LOCAL_MODEL_TEMPERATURE=0.7
# ENV GOOGLE_MODEL_ID=gemini-2.5-flash

# Expose the application port
EXPOSE 8080

# Health check
HEALTHCHECK --interval=30s --timeout=30s --start-period=5s --retries=3 \
    CMD curl -f http://localhost:8080/docs || exit 1

# Run the application
CMD ["uvicorn", "src.main:app", "--host", "0.0.0.0", "--port", "8080"]